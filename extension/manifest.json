{
  "manifest_version": 3,
  "name": "三笙 · 电商商品分析闭环 V9.2.5",
  "version": "9.2.5",
  "description": "跨类目电商商品分析：动态参数与SKU采集、图文分源、评论证据、开品与AI视觉方案。",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://detail.tmall.com/*",
    "https://*.tmall.com/*",
    "https://*.taobao.com/*",
    "https://*.alicdn.com/*",
    "http://127.0.0.1:17962/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "三笙 · 电商商品分析闭环 V9.2.5"
  },
  "content_scripts": [
    {
      "matches": [
        "https://detail.tmall.com/*",
        "https://*.tmall.com/*",
        "https://item.taobao.com/*",
        "https://*.taobao.com/*"
      ],
      "js": [
        "page-review-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
